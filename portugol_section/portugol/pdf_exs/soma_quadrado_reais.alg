
inicio
	real num1, num2, quadrado1, quadrado2, soma
      escrever "Introduza dois números - pode ser com ou sem vírgulas. \n"
      ler num1, num2
      
      quadrado1 <- num1 ^ 2
      quadrado2 <- num2 ^ 2
      
      soma <- quadrado1 + quadrado2
      
      escrever "O quadrado da soma dos dois números é de ", soma, "."
      
      
fim
