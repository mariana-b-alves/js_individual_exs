
inicio
	inteiro num1, num2, num3, soma, final
      escrever "Introduz três números. \n"
      ler num1, num2, num3
      
      
      soma <- num1 + num2 + num3
      escrever "A soma de todos os números é ", soma, ". \n"
      
      final <- soma * 2
      escrever "O quadrado da soma dos números é ", final, ".\n"
fim
