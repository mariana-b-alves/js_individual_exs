inicio
   texto nome
   escrever "Escreva o seu nome."
   ler nome
   texto genero
   escrever "Digite o seu género: masculino/feminino."
   ler genero
  
   
   se genero = "masculino" ou genero = "Masculino" ou genero = "m" ou genero = "M" entao
       escrever "Olá, Sr. ", nome
   senao
       escrever "Olá, Sra. ", nome
   fimse 
 fim
