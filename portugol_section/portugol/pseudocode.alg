inicio
   inteiro num //declarar número inteiro
   ler num  //pedir número e guardar na variável
   
   //Estrutura de decisão, certificar se é maior que 10
   
   se num >= 10 entao
       escrever "O numero ", num, " é maior que 10." 
   senao 
       escrever "O numero ", num, " é menor que 10."
   fimse
    
fim


